{
  "name": "linewatch",
  "version": "2.0.0",
  "private": true,
  "description": "Pole inspection, line mapping and AI-assisted grading for electric utilities",
  "type": "module",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.mjs",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "leaflet": "1.9.4"
  }
}
