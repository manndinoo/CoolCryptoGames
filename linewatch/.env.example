# Copy to .env and fill in. Never commit .env.

# AI provider. Claude is used when ANTHROPIC_API_KEY is set; OpenAI is the fallback.
ANTHROPIC_API_KEY=
# LINEWATCH_MODEL=claude-opus-5-5
# LINEWATCH_EFFORT=high          # low | medium | high | xhigh | max
# OPENAI_API_KEY=
# LINEWATCH_OPENAI_MODEL=gpt-5.4-mini
# LINEWATCH_AI_PROVIDER=anthropic   # force one provider when both keys are set

# Where the database and photos are stored. Back this folder up.
# LINEWATCH_DATA_DIR=./data
# PORT=3000

# Set in production so session cookies are HTTPS-only.
# NODE_ENV=production

# Optional: serve HTTPS directly (phones need HTTPS for camera and GPS).
# LINEWATCH_TLS_CERT=./cert.pem
# LINEWATCH_TLS_KEY=./key.pem
