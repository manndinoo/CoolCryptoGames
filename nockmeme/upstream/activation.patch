+++ b/hoon/tests/dumb/mod/unit/nmeme-upgrade.hoon
@@ -0,0 +1,94 @@
+/=  t  /common/tx-engine-1
+/=  policy  /common/nmeme-policy
+/=  *  /common/zeke
+/=  *  /common/h-zoon
+|%
+++  data
+  |=  value=(unit *)
+  ^-  note-data:t
+  ?~  value  *note-data:t
+  (~(put z-by *note-data:t) %meme u.value)
+++  fixture
+  |=  [origin=@ incoming=(unit *) outgoing=(unit *) pool=?]
+  ^-  [balance=(h-map nname:t nnote:t) sps=spends:t]
+  =/  prim=lock-primitive:t
+    ?:  pool  [%amm *hash:t 0 0 *hash:t]
+    [%tim *tim:t]
+  =/  script=lock:t  ~[prim]
+  =/  root=hash:t  (hash:lock:t script)
+  =/  note=nnote-1:t
+    %*  .  *nnote-1:t
+      version      %1
+      origin-page  origin
+      name         (new-v1:nname:t root [*hash:t %.n])
+      note-data    (data incoming)
+      assets       1.000
+    ==
+  =/  sed=seed:t
+    %*  .  *seed:t
+      lock-root    root
+      note-data    (data outgoing)
+      gift         1.000
+      parent-hash  (hash:nnote-1:t note)
+    ==
+  =/  wit=witness:t  *witness:t
+  =.  wit  wit(lmp (build-lock-merkle-proof-stub:lock:t script 1))
+  =/  sp=spend-1:t
+    %*  .  *spend-1:t
+      witness  wit
+      seeds    (~(put z-in *seeds:t) sed)
+      fee      0
+    ==
+  :*  (~(put h-by *(h-map nname:t nnote:t)) name.note note)
+      (~(put z-by *spends:t) name.note [%1 sp])
+  ==
+++  accepted
+  |=  [activation=(unit @) height=@ origin=@ incoming=(unit *) outgoing=(unit *) pool=?]
+  ^-  ?
+  =/  f  (fixture origin incoming outgoing pool)
+  =/  result=(reason:t ~)
+    (validate-at-phase:spends:t balance.f sps.f height 2.048 0 0 activation)
+  ?=(%.y -.result)
+++  claim
+  |=  amount=@
+  ^-  (unit *)
+  `[%0 %t *hash:t amount]
+++  genesis
+  ^-  (unit *)
+  =/  f  (fixture 50 ~ ~ %.n)
+  =/  anchor=(unit nname:t)  (anchor:meme:t sps.f)
+  ?>  ?=(^ anchor)
+  `[%0 %c ~['TEST'] 0 100 (derive:meme:t u.anchor ~['TEST'] 0)]
+++  results
+  ^-  (list ?)
+  :~  !(active:policy ~ 1.000.000)
+      !(active:policy `100 99)
+      (active:policy `100 100)
+      (active:policy `100 101)
+      !(creditable:policy `100 101 99)
+      (creditable:policy `100 101 100)
+      !(creditable:policy `100 101 102)
+      ::  Arbitrary metadata retains its historical behavior before activation.
+      (accepted ~ 101 50 ~ `123 %.n)
+      (accepted `100 99 50 ~ `123 %.n)
+      !(accepted `100 100 50 ~ `123 %.n)
+      !(accepted `100 101 50 ~ `123 %.n)
+      ::  Legacy claims cannot acquire credit; their native NOCK can be spent.
+      !(accepted `100 101 99 (claim 100) (claim 100) %.n)
+      (accepted `100 101 99 (claim 100) ~ %.n)
+      (accepted `100 101 100 (claim 100) (claim 100) %.n)
+      !(accepted `100 101 100 (claim 100) (claim 101) %.n)
+      (accepted `100 101 100 (claim 100) (claim 99) %.n)
+      ::  New genesis is valid without importing historical token weight.
+      (accepted `100 100 50 ~ genesis %.n)
+      ::  Pool spend: a no-op preserves the exact invariant.
+      !(accepted ~ 101 100 (claim 100) (claim 100) %.y)
+      !(accepted `100 99 50 (claim 100) (claim 100) %.y)
+      (accepted `100 100 100 (claim 100) (claim 100) %.y)
+      (accepted `100 101 100 (claim 100) (claim 100) %.y)
+      !(accepted `100 101 99 (claim 100) (claim 100) %.y)
+      ::  Re-evaluating an earlier height must restore the earlier rules.
+      (accepted `100 99 50 ~ `123 %.n)
+      (accepted `100 101 50 ~ ~ %.n)
+  ==
