# ---------------------------------------------------------------- database
# Postgres connection string. Vercel Postgres or Neon both work as-is.
DATABASE_URL=

# ------------------------------------------------------------------ secrets
# All three must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Rotating a pepper is not a routine operation: it changes every derived hash,
# which silently drops every existing device ban (FINGERPRINT_PEPPER) or IP ban
# (IP_HASH_PEPPER). Rotate only deliberately, and expect to re-issue bans.
SESSION_SECRET=
IP_HASH_PEPPER=
FINGERPRINT_PEPPER=

# ------------------------------------------------------------------- solana
# The public default is rate-limited and unsuitable for production traffic.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---------------------------------------------------------------- anti-sybil
# Both are OFF by default. A wallet costs nothing to create, so without one of
# these, "connect a wallet" is not a barrier to a bot — it is one line of code.
# Turning them on excludes genuinely new players, so it is a product decision.
#
# Minimum SOL the wallet must hold to sign in.
MIN_WALLET_SOL=0
# Minimum age, in days, of the wallet's oldest visible transaction.
MIN_WALLET_AGE_DAYS=0
